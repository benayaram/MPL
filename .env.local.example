# ==========================================
# MPL MINISTRIES WEBSITE ENVIRONMENT CONFIG
# ==========================================

# 1. MongoDB Atlas Connection URI (Free M0 Cluster)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mpl_ministries?retryWrites=true&w=majority

# 2. Authentication Secret (Generate a random string)
JWT_SECRET=mpl_ministries_production_secret_key_change_me_2026

# 3. Initial Admin Credentials (Used on first setup)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# 4. Cloudinary Free Tier Credentials (Direct Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. YouTube Data API v3 Key & Channel ID (Live Detection)
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key
YOUTUBE_CHANNEL_ID=@mplministries

# 6. Resend Free Tier Credentials (Prayer Request Email Notifications)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=ministriesmpl7@gmail.com

# 7. Site Public Domain
NEXT_PUBLIC_SITE_URL=https://mplministries.vercel.app
